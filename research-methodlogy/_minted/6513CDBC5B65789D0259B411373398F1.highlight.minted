    \PYGZsh{} Code Mode: Validate Objective Logic
    def validate\PYG{n+nb}{\PYGZus{}}objective(intent, phenomenon, participants, site):
        action\PYG{n+nb}{\PYGZus{}}verbs = [\PYGZdq{}identify\PYGZdq{}, \PYGZdq{}determine\PYGZdq{}, \PYGZdq{}describe\PYGZdq{}, \PYGZdq{}develop\PYGZdq{}, \PYGZdq{}explore\PYGZdq{}]
        if intent.lower() not in action\PYG{n+nb}{\PYGZus{}}verbs:
            return \PYGZdq{}Warning: Use a stronger action verb for clarity.\PYGZdq{}
        if not (phenomenon and participants and site):
            return \PYGZdq{}Error: Objectives must specify what, for whom, and where.\PYGZdq{}
        return \PYGZdq{}Objective is valid and researchable.\PYGZdq{}
